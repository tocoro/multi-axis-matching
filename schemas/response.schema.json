{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/response.schema.json",
  "title": "EvaluationResponse",
  "type": "object",
  "required": [
    "request_id",
    "inferred_problem_type",
    "problem_type_confidence",
    "selected_axes",
    "ranking"
  ],
  "additionalProperties": false,
  "properties": {
    "request_id": { "type": "string" },
    "inferred_problem_type": { "type": "string" },
    "problem_type_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "extracted_constraints": {
      "type": "object",
      "additionalProperties": true
    },
    "selected_axes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["axis", "weight"],
        "properties": {
          "axis": { "type": "string" },
          "weight": { "type": "number" }
        }
      }
    },
    "ranking": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rank",
          "candidate_id",
          "total_score",
          "confidence",
          "axis_scores"
        ],
        "properties": {
          "rank": { "type": "integer" },
          "candidate_id": { "type": "string" },
          "total_score": { "type": "number" },
          "confidence": { "type": "number" },
          "disqualified": { "type": "boolean" },
          "disqualification_reasons": {
            "type": "array",
            "items": { "type": "string" }
          },
          "axis_scores": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["axis", "score", "status"],
              "properties": {
                "axis": { "type": "string" },
                "score": { "type": "number" },
                "status": {
                  "type": "string",
                  "enum": ["supported", "unknown", "conflict"]
                },
                "reason": { "type": "string" },
                "hard_constraint_violation": { "type": "boolean" }
              }
            }
          },
          "strengths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "weaknesses": {
            "type": "array",
            "items": { "type": "string" }
          },
          "missing_information": {
            "type": "array",
            "items": { "type": "string" }
          },
          "risk_notes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "summary_reason": { "type": "string" }
        }
      }
    },
    "global_missing_information": {
      "type": "array",
      "items": { "type": "string" }
    },
    "needs_human_review": { "type": "boolean" },
    "search_diagnostics": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
