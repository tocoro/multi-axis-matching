# LLM model (determines provider automatically)
# claude-*  → Anthropic
# gpt-*/o1-*/o3-*/o4-* → OpenAI
# gemini-*  → Google Gemini
EVAL_MODEL=claude-sonnet-4-6

# Or set provider explicitly (overrides auto-detection)
# EVAL_PROVIDER=anthropic

# API keys — set the one matching your provider
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
